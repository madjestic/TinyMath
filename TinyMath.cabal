cabal-version:        3.8
name:                 TinyMath
version:              0.3.0.0
synopsis:             Experimental Math Lib
-- description:        
license:              BSD-3-Clause
license-file:         LICENSE
author:               madiestic
maintainer:           madjestic13@gmail.com
-- copyright:          
category:             Math
build-type:           Simple
extra-doc-files:      CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options:     -Wall
                     -Wcompat
                     -fprint-potential-instances
                     -Widentities
                     -Wincomplete-record-updates
                     -Wincomplete-patterns
                     -Wincomplete-uni-patterns
                     -Wpartial-fields
                     -Wredundant-constraints
                     -Wname-shadowing
                     -Werror=name-shadowing

common shared
    ghc-options:     -threaded -O2
    build-depends:    base ^>=4.19.2.0
                    , Chart
                    , Chart-cairo
                    , linear
                    , massiv
                    , inline-c
                    , template-haskell
                    , binary
                    , uuid
                    , random
                    , bytestring
                    , locators
                    , containers
    default-language: GHC2021

library
    import:           warnings
                    , shared
    exposed-modules:  Numeric.Tiny
                    , Numeric.Tiny.Math
                    , Numeric.Tiny.Arithmetic
                    , Numeric.Tiny.RealArithmetic
                    , Numeric.Tiny.Egyptian
                    , Numeric.Tiny.Random
    other-modules:    Paths_TinyMath
    build-depends:    base ^>=4.19.2.0

    hs-source-dirs:   src
    include-dirs:     src
    c-sources:        src/halff.c
                    , src/mult.c
                    , src/length.c
                    , src/doubleIntArray.c

executable TinyMath
    import:           warnings
                    , shared
    main-is:          Main.hs
    build-depends:
          base ^>=4.19.2.0
        , TinyMath

    hs-source-dirs:   app

executable ArithmeticsRepetitor
    import:           warnings
                    , shared
    main-is:          ArithmeticsRepetitor.hs
    build-depends:
          base ^>=4.19.2.0
        , TinyMath

    hs-source-dirs:   app
